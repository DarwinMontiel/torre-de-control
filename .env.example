# Copiar a .env y ajustar. Todas las variables de la torre usan el prefijo TORRE_.

# Servidor
TORRE_PUERTO=3000
TORRE_NIVEL_LOG=info
# Identidad de esta réplica para el candado de líder del vigía (por defecto: hostname-pid)
# TORRE_NODO=api-1

# Almacenamiento: postgres | memoria (memoria = sin base de datos, solo para desarrollo)
TORRE_ALMACEN=postgres
TORRE_DATABASE_URL=postgres://torre:torre@localhost:5432/torre
# Sin TORRE_REDIS_URL el estado vivo queda en memoria (una sola réplica)
TORRE_REDIS_URL=redis://localhost:6379
# Carga el catálogo ficticio de Cobranzas Macondo si el catálogo está vacío
TORRE_SEMBRAR_MACONDO=false

# Fuente de métricas de colas: rabbitmq | simulada
TORRE_FUENTE_COLAS=simulada
TORRE_RABBITMQ_URL=http://localhost:15672
TORRE_RABBITMQ_USUARIO=guest
TORRE_RABBITMQ_CLAVE=guest
TORRE_RABBITMQ_VHOST=/
TORRE_RABBITMQ_PREFIJO=rpa.
# Solo modo simulado: minutos de la noche por minuto real
TORRE_ACELERACION_SIMULADOR=10

# Vigía y reglas
TORRE_INTERVALO_VIGIA_MS=5000
TORRE_TTL_LATIDO_SEG=45
TORRE_RETENCION_LATIDO_SEG=21600
TORRE_VENTANA_TENDENCIA_MIN=10
TORRE_COBERTURA_MINIMA_MIN=3
# Lista separada por comas: cola_creciendo,cola_sin_consumidores,dlq_con_mensajes,bot_sin_latido,servidor_caido
TORRE_REGLAS_DESACTIVADAS=

# Seguridad (sin tokens, las escrituras quedan abiertas: solo para desarrollo)
TORRE_TOKEN_BOTS=
TORRE_TOKEN_ADMIN=
TORRE_AUTOREGISTRO=true

# Avisos
TORRE_WEBHOOK_URL=
TORRE_CORREO_DESTINATARIOS=turno-noche@macondo.example
